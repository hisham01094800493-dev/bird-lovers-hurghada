# Vercel/Aiven production variables. Put actual values in provider dashboards only.
DATABASE_URL=mysql://USER:PERCENT_ENCODED_PASSWORD@HOST:PORT/defaultdb
AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----\nPASTE_AIVEN_CA_CERTIFICATE_HERE\n-----END CERTIFICATE-----
JWT_SECRET=generate-a-long-random-secret
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_SITE_URL=https://bird-lovers-hurghada.vercel.app
OWNER_OPEN_ID=
PRICE_REFRESH_SECRET=generate-a-separate-random-secret
CRON_SECRET=generate-another-long-random-secret

# Required for durable image and attachment uploads on Vercel (S3-compatible storage).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Optional analytics. The app build remains valid if these are not supplied.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Feature-dependent integrations. Keep server-only credentials unprefixed.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
